# Proveedor inicial: anthropic u openai
CHAT_PROVIDER=anthropic
# Modelo inicial del chat. También se puede usar ANTHROPIC_MODEL u OPENAI_MODEL.
# CHAT_MODEL=auto/best-coding

# Anthropic, o un gateway compatible con su API
ANTHROPIC_API_KEY=tu-api-key
ANTHROPIC_BASE_URL=http://localhost:20128

# OpenAI, o un gateway compatible con su API. La URL puede incluir /v1 o no.
# OPENAI_API_KEY=tu-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
