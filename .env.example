# ---------------------------------------------------------------------------
# Multi-provider terminal chatbot - environment configuration
# Copy this file to .env and replace the placeholders. NEVER commit .env.
# ---------------------------------------------------------------------------

# Provider used when the chat starts: anthropic | openai | groq | openrouter
CHAT_PROVIDER=anthropic
# Model of the first conversation only (optional).
# CHAT_MODEL=claude-sonnet-4-5

# --- 100% FREE setup (no credit card) ----------------------------------------
# 1. Chat provider: free Groq key at https://console.groq.com
#      -> set CHAT_PROVIDER=groq (uses the official OpenAI SDK adapter)
#    or free OpenRouter models: https://openrouter.ai (models ending in :free)
#      -> set CHAT_PROVIDER=openrouter
# 2. Vector database: free Supabase project at https://supabase.com
# 3. Embeddings (optional, free): Google AI Studio key at https://aistudio.google.com
#      -> EMBEDDING_API_KEY=<your-google-key>
#      -> EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#      -> EMBEDDING_MODEL=text-embedding-004
#      -> EMBEDDING_DIMENSIONS=768 and vector(768) in data/supabase/schema.sql
# ---------------------------------------------------------------------------

# --- Anthropic (official API) ------------------------------------------------
# Docs: https://docs.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional endpoint override. Leave unset to call the official API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Default model for this provider.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI (official API) ---------------------------------------------------
# Docs: https://platform.openai.com/docs
OPENAI_API_KEY=your-openai-api-key
# Optional endpoint override; the /v1 suffix is added automatically if missing.
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Groq (free tier, OpenAI-compatible) --------------------------------------
# Free key: https://console.groq.com | Endpoint: https://api.groq.com/openai/v1
# Uses the official OpenAI SDK adapter. Models: llama-3.1-8b-instant,
# llama-3.3-70b-versatile, ...
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# --- OpenRouter (free models, OpenAI-compatible) ------------------------------
# Free key: https://openrouter.ai | Endpoint: https://openrouter.ai/api/v1
# Uses the official OpenAI SDK adapter. Free models end with :free, e.g.
# meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Supabase hosted: vector database for RAG (free tier works) ---------------
# Create a project at https://supabase.com/, then run data/supabase/schema.sql
# in the SQL editor. Both values come from Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_TABLE=documents

# --- Embeddings (optional overrides) ------------------------------------------
# By default embeddings use OPENAI_API_KEY and the text-embedding-3-small model.
# Point them at any free OpenAI-compatible service instead, for example
# Google AI Studio (see the FREE setup block above).
# EMBEDDING_API_KEY=your-embeddings-api-key
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDING_MODEL=text-embedding-004

# --- RAG tuning (optional) ---------------------------------------------------
# DOCUMENTS_DIR=data/documents
# RAG_TOP_K=5
# RAG_SIMILARITY_THRESHOLD=0.20
# EMBEDDING_DIMENSIONS=1536

# --- Saved chats (optional) --------------------------------------------------
# CHAT_DB_PATH=data/chats.db
