# ---------------------------------------------------------------------------
# Multi-provider terminal chatbot - environment configuration
# Copy this file to .env and replace the placeholders. NEVER commit .env.
# ---------------------------------------------------------------------------

# Provider used when the chat starts: anthropic | openai
CHAT_PROVIDER=anthropic
# Model of the first conversation only (optional).
# CHAT_MODEL=claude-sonnet-4-5

# --- Anthropic (official API) ------------------------------------------------
# Docs: https://docs.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional endpoint override. Leave unset to call the official API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Default model for this provider.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI (official API, also used for RAG embeddings) ---------------------
# Docs: https://platform.openai.com/docs
OPENAI_API_KEY=your-openai-api-key
# Optional endpoint override; the /v1 suffix is added automatically if missing.
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Supabase hosted: vector database for RAG --------------------------------
# Create a project at https://supabase.com/, then run data/supabase/schema.sql
# in the SQL editor. Both values come from Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_TABLE=documents

# --- RAG tuning (optional) ---------------------------------------------------
# DOCUMENTS_DIR=data/documents
# RAG_TOP_K=5
# RAG_SIMILARITY_THRESHOLD=0.20
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Saved chats (optional) --------------------------------------------------
# CHAT_DB_PATH=data/chats.db
